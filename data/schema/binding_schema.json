{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "binding",
  "title": "BindingPanelList",
  "description": "状态面板绑点结构，包裹在控件 a.panel.list 中",
  "type": "object",
  "required": ["panel.list"],
  "properties": {
    "panel.list": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "bind"],
        "properties": {
          "label": {
            "type": "string",
            "description": "属性显示名"
          },
          "bind": {
            "type": "object",
            "required": ["type", "path", "key", "label", "proj", "dev", "param"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["designer"],
                "description": "绑定来源类型"
              },
              "path": {
                "type": "string",
                "description": "projectId#deviceId#propertyId"
              },
              "key": {
                "type": "string",
                "description": "deviceId#propertyId"
              },
              "label": {
                "type": "string",
                "description": "项目名 . 设备名 . 属性名 (单位)"
              },
              "proj": {
                "type": "object",
                "required": ["id", "name"],
                "properties": {
                  "id": {"type": "string"},
                  "name": {"type": "string"}
                }
              },
              "dev": {
                "type": "object",
                "required": ["id", "name"],
                "properties": {
                  "id": {"type": "string"},
                  "name": {"type": "string"}
                }
              },
              "param": {
                "type": "object",
                "required": ["id", "name", "unit", "writable", "dataType", "dataTypeDesc"],
                "properties": {
                  "id": {"type": "string"},
                  "name": {"type": "string"},
                  "unit": {"type": "string"},
                  "writable": {"type": "boolean"},
                  "dataType": {
                    "type": "string",
                    "enum": ["double", "int", "bool", "string"]
                  },
                  "dataTypeDesc": {"type": "string"}
                }
              }
            }
          }
        }
      }
    }
  }
}
